diff -ruN a/include/libfyaml/libfyaml-atomics.h b/include/libfyaml/libfyaml-atomics.h
--- a/include/libfyaml/libfyaml-atomics.h	2026-11-13 21:27:46.521751376 +0100
+++ b/include/libfyaml/libfyaml-atomics.h	2026-11-13 21:28:05.621554676 +0100
@@ -50,6 +50,34 @@
 #include <stdbool.h>
 #include <stdint.h>
 
+/*
+ * C++: `_Atomic` is a C11 keyword that g++ rejects, and the non-atomic
+ * fallback further down does not compile. Map the C11 names onto <atomic>,
+ * as C++23's <stdatomic.h> does. libfyaml.h includes this header inside its
+ * extern "C" block, hence the extern "C++" wrapper.
+ */
+#if defined(__cplusplus) && !defined(FY_HAVE_C11_ATOMICS)
+extern "C++" {
+#include <atomic>
+using std::atomic_flag;
+using std::atomic_load;
+using std::atomic_store;
+using std::atomic_exchange;
+using std::atomic_compare_exchange_strong;
+using std::atomic_compare_exchange_weak;
+using std::atomic_fetch_add;
+using std::atomic_fetch_sub;
+using std::atomic_fetch_or;
+using std::atomic_fetch_xor;
+using std::atomic_fetch_and;
+using std::atomic_flag_clear;
+using std::atomic_flag_test_and_set;
+}
+#define _Atomic(_x) std::atomic<_x>
+#define FY_HAVE_STDATOMIC_H
+#define FY_HAVE_C11_ATOMICS
+#endif
+
 #ifdef __cplusplus
 extern "C" {
 #endif
diff -ruN a/include/libfyaml.h b/include/libfyaml.h
--- a/include/libfyaml.h	2026-11-13 21:28:22.181382406 +0100
+++ b/include/libfyaml.h	2026-11-13 21:28:22.209382113 +0100
@@ -28,6 +28,12 @@
 #define LIBFYAML_H
 
 #ifdef __cplusplus
+/* Before extern "C": libfyaml-atomics.h maps the C11 atomics onto <atomic>
+ * in C++, and the C++ library must not be included with C linkage. */
+#include <atomic>
+#endif
+
+#ifdef __cplusplus
 extern "C" {
 #endif
 
